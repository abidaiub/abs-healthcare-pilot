# Render with envsubst on the server after setting both hostnames and ports.
# Do not enable HSTS until both HTTPS virtual hosts are verified and renewal is monitored.

server {
    listen 80;
    listen [::]:80;
    server_name ${HEALTHCARE_QC_HOSTNAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${HEALTHCARE_QC_HOSTNAME};

    ssl_certificate ${HEALTHCARE_QC_TLS_CERTIFICATE};
    ssl_certificate_key ${HEALTHCARE_QC_TLS_PRIVATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ABSHealthcareQC:10m;
    ssl_session_timeout 1d;

    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    location / {
        proxy_pass http://127.0.0.1:${HEALTHCARE_QC_APP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

