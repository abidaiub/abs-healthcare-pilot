# Safe template only. Copy to a server-owned file outside Git and replace every placeholder.
COMPOSE_PROJECT_NAME=abs-healthcare-qc

HEALTHCARE_QC_POSTGRES_USER=abshealthcare_qc
HEALTHCARE_QC_POSTGRES_PASSWORD=replace-with-url-safe-random-secret
HEALTHCARE_QC_POSTGRES_DB=abs_healthcare_qc
HEALTHCARE_QC_APP_PORT=3000
HEALTHCARE_QC_HOSTNAME=replace-with-healthcare-qc-hostname
HEALTHCARE_QC_TLS_CERTIFICATE=/etc/letsencrypt/live/replace-healthcare-host/fullchain.pem
HEALTHCARE_QC_TLS_PRIVATE_KEY=/etc/letsencrypt/live/replace-healthcare-host/privkey.pem
HEALTHCARE_QC_SESSION_TOKEN_PEPPER=replace-with-independent-32-plus-byte-secret

LAB_LITE_QC_POSTGRES_USER=abs_lab_lite_qc
LAB_LITE_QC_POSTGRES_PASSWORD=replace-with-url-safe-random-secret
LAB_LITE_QC_POSTGRES_DB=abs_lab_lite_qc
LAB_LITE_QC_APP_PORT=3100
LAB_LITE_QC_HOSTNAME=replace-with-lab-lite-qc-hostname
LAB_LITE_QC_TLS_CERTIFICATE=/etc/letsencrypt/live/replace-lab-lite-host/fullchain.pem
LAB_LITE_QC_TLS_PRIVATE_KEY=/etc/letsencrypt/live/replace-lab-lite-host/privkey.pem
LAB_LITE_QC_APP_ORIGIN=https://replace-with-qc-lab-hostname
LAB_LITE_QC_SESSION_TOKEN_PEPPER=replace-with-independent-32-plus-byte-secret
LAB_LITE_QC_DEVICE_AUTH_PEPPER=replace-with-independent-32-plus-byte-secret
LAB_LITE_QC_DEVICE_LEASE_PRIVATE_KEY_PEM_BASE64=replace-with-base64-ed25519-private-key-pem
LAB_LITE_QC_DEVICE_LEASE_PUBLIC_KEY_PEM_BASE64=replace-with-base64-ed25519-public-key-pem
