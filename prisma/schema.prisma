/// Raw analyzer/LIS message archive and processing queue (MOD-22 AnalyzerImportQueue)
model AnalyzerImportQueue {
  id               String                @id @default(cuid())
  tenantId         String                @map("tenant_id")
  branchId         String                @map("branch_id")
  analyzerId       String?               @map("analyzer_id")
  /// Barcode/accession value transmitted by the machine, never the patient name.
  machineSampleId  String                @map("machine_sample_id")
  machineTestCode  String?               @map("machine_test_code")
  /// Message control identifier from the transport payload; makes ingest idempotent.
  messageControlId String                @map("message_control_id")
  importChannel    AnalyzerImportChannel @map("import_channel")
  rawPayload       String                @map("raw_payload")
  processedStatus  AnalyzerImportStatus  @default(PENDING) @map("processed_status")
  labSampleId      String?               @map("lab_sample_id")
  labOrderTestId   String?               @map("lab_order_test_id")
  labResultId      String?               @map("lab_result_id")
  receivedAt       DateTime              @default(now()) @map("received_at")
  processedAt      DateTime?             @map("processed_at")
  processedById    String?               @map("processed_by_id")
  attemptCount     Int                   @default(0) @map("attempt_count")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  analyzer     Analyzer?            @relation(fields: [analyzerId], references: [id], onDelete: SetNull)
  labSample    LabSample?           @relation(fields: [labSampleId], references: [id], onDelete: SetNull)
  labOrderTest LabOrderTest?        @relation(fields: [labOrderTestId], references: [id], onDelete: SetNull)
  labResult    LabResult?           @relation(fields: [labResultId], references: [id], onDelete: SetNull)
  errors       AnalyzerErrorQueue[]

  @@unique([tenantId, messageControlId])
  @@index([tenantId])
  @@index([tenantId, processedStatus])
  @@index([tenantId, machineSampleId])
  @@index([tenantId, receivedAt])
  @@map("analyzer_import_queue")
}

