  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctorId, branchId])
  @@index([tenantId])
  @@index([doctorId])
  @@index([branchId])
  @@index([createdAt])
  @@map("doctor_branches")
}

/// Weekly consultation shift template for a doctor at one branch (MOD-17 DoctorSchedule).
/// Published rows drive the bookable slot list; unpublished rows are drafts only.
model DoctorSchedule {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  branchId     String    @map("branch_id")
  doctorId     String    @map("doctor_id")
  dayOfWeek    Int       @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  slotDuration Int       @map("slot_duration")
  chamber      String?
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at")
  publishedBy  String?   @map("published_by")
  isActive     Boolean   @default(true) @map("is_active")
  /// Optimistic concurrency token for edit / publish / deactivate.
  stateVersion Int       @default(1) @map("state_version")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, doctorId, dayOfWeek, startTime], map: "doctor_schedules_tenant_branch_doctor_day_start_key")
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, doctorId, dayOfWeek], map: "doctor_schedules_tenant_branch_doctor_day_idx")
  @@index([doctorId])
  @@index([createdAt])
  @@map("doctor_schedules")
}

/// Department-level reporting/verification privileges for a doctor
model DoctorDepartmentMapping {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  doctorId     String   @map("doctor_id")
  departmentId String   @map("department_id")
  canReport    Boolean  @default(false) @map("can_report")
  canVerify    Boolean  @default(false) @map("can_verify")
  canRelease   Boolean  @default(false) @map("can_release")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctorId, departmentId])
  @@index([tenantId])
  @@index([doctorId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("doctor_department_mappings")
}

/// Per test/department doctor assignment for report workflow
model ReportDoctorAssignment {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  branchId           String?   @map("branch_id")
  tenantServiceId    String?   @map("tenant_service_id")
  departmentId       String    @map("department_id")
  reportingDoctorId  String?   @map("reporting_doctor_id")
  verifyingDoctorId  String?   @map("verifying_doctor_id")
  consultantDoctorId String?   @map("consultant_doctor_id")
  defaultForReport   Boolean   @default(false) @map("default_for_report")
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdBy          String?   @map("created_by")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  updatedBy          String?   @map("updated_by")

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tenantService    TenantService? @relation(fields: [tenantServiceId], references: [id], onDelete: SetNull)
  department       Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reportingDoctor  Doctor?        @relation("ReportingDoctor", fields: [reportingDoctorId], references: [id], onDelete: SetNull)
  verifyingDoctor  Doctor?        @relation("VerifyingDoctor", fields: [verifyingDoctorId], references: [id], onDelete: SetNull)
  consultantDoctor Doctor?        @relation("ConsultantDoctor", fields: [consultantDoctorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, isActive])
  @@index([tenantServiceId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("report_doctor_assignments")
}

