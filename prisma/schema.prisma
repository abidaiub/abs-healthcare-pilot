  revokedById      String?   @map("revoked_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdById      String?   @map("created_by_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantorPatient Patient              @relation("PortalDelegationGrantor", fields: [grantorPatientId], references: [id], onDelete: Cascade)
  granteeAccount PatientPortalAccount @relation("PortalDelegationGrantee", fields: [granteeAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, grantorPatientId, granteeAccountId])
  @@index([tenantId])
  @@index([tenantId, granteeAccountId])
  @@map("patient_portal_delegations")
}

