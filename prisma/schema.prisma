enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum NotificationEventType {
  LAB_REPORT_READY
  INVOICE_PAYMENT_RECEIPT
  CRITICAL_RESULT_ALERT
}

/// Tenant notification message template per event, channel and locale (MOD-05)
model NotificationTemplate {
  id           String                @id @default(cuid())
  tenantId     String                @map("tenant_id")
  eventType    NotificationEventType @map("event_type")
  channel      NotificationChannel
  locale       String                @default("en-BD")
  /// Body may reference {{tenantName}}, {{orderReference}}, {{patientName}} only.
  bodyTemplate String                @map("body_template")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, channel, locale])
  @@index([tenantId])
  @@map("notification_templates")
}

/// Outbound notification queue with delivery state and provider reference (MOD-05)
model NotificationOutbox {
  id                String                @id @default(cuid())
  tenantId          String                @map("tenant_id")
  branchId          String?               @map("branch_id")
  eventType         NotificationEventType @map("event_type")
  channel           NotificationChannel
  status            NotificationStatus    @default(PENDING)
  recipientName     String?               @map("recipient_name")
  recipientMobile   String?               @map("recipient_mobile")
  recipientEmail    String?               @map("recipient_email")
  messageBody       String                @map("message_body")
  /// Stable key that makes enqueue and retry idempotent for the same business event.
  dedupeKey         String                @map("dedupe_key")
  entityType        String?               @map("entity_type")
  entityId          String?               @map("entity_id")
  attemptCount      Int                   @default(0) @map("attempt_count")
  lastAttemptAt     DateTime?             @map("last_attempt_at")
  sentAt            DateTime?             @map("sent_at")
  failureReason     String?               @map("failure_reason")
  providerName      String?               @map("provider_name")
  providerReference String?               @map("provider_reference")
  createdAt         DateTime              @default(now()) @map("created_at")
  createdById       String?               @map("created_by_id")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@map("notification_outbox")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceDiscountType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
}

enum InvoicePaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  BANK_TRANSFER
  CHEQUE
}

enum InvoicePaymentStatus {
  RECEIVED
  REVERSED
}

enum InvoiceDiscountEventType {
  APPLIED
  MODIFIED
  REMOVED
}

/// Tenant-scoped invoice counter (MOD-10)
model TenantInvoiceCounter {
  tenantId   String @id @map("tenant_id")
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_invoice_counters")
}

/// Tenant-scoped payment receipt counter (MOD-10)
model TenantReceiptCounter {
  tenantId   String @id @map("tenant_id")
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_receipt_counters")
}

/// Diagnostic invoice header (MOD-10). Gross - Discount = Net; Net - Paid = Due.
model Invoice {
  id                     String              @id @default(cuid())
  tenantId               String              @map("tenant_id")
  branchId               String              @map("branch_id")
  patientId              String              @map("patient_id")
  labOrderId             String?             @unique @map("lab_order_id")
  invoiceNumber          String              @map("invoice_number")
  status                 InvoiceStatus       @default(DRAFT)
  currencyCode           String              @default("BDT") @map("currency_code")
  grossAmount            Decimal             @default(0) @map("gross_amount") @db.Decimal(18, 2)
  discountType           InvoiceDiscountType @default(NONE) @map("discount_type")
  discountValue          Decimal             @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount         Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 2)
  discountReason         String?             @map("discount_reason")
  discountApprovedById   String?             @map("discount_approved_by_id")
  discountApprovedByName String?             @map("discount_approved_by_name")
  discountApprovedAt     DateTime?           @map("discount_approved_at")
  netAmount              Decimal             @default(0) @map("net_amount") @db.Decimal(18, 2)
  paidAmount             Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 2)
  dueAmount              Decimal             @default(0) @map("due_amount") @db.Decimal(18, 2)
  recordVersion          Int                 @default(1) @map("record_version")
  issuedAt               DateTime?           @map("issued_at")
  cancelledAt            DateTime?           @map("cancelled_at")
  cancellationReason     String?             @map("cancellation_reason")
  createdAt              DateTime            @default(now()) @map("created_at")
  createdById            String?             @map("created_by_id")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  updatedById            String?             @map("updated_by_id")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  labOrder       LabOrder?              @relation(fields: [labOrderId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       InvoicePayment[]
  discountEvents InvoiceDiscountEvent[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

/// Invoice line with catalog price snapshot preserved at billing time (MOD-10)
model InvoiceItem {
  id                      String   @id @default(cuid())
  tenantId                String   @map("tenant_id")
  invoiceId               String   @map("invoice_id")
  tenantServiceId         String?  @map("tenant_service_id")
  labOrderTestId          String?  @unique @map("lab_order_test_id")
  testCode                String?  @map("test_code")
  testName                String   @map("test_name")
  departmentId            String?  @map("department_id")
  unitPrice               Decimal  @map("unit_price") @db.Decimal(18, 2)
  quantity                Int      @default(1)
  lineGrossAmount         Decimal  @map("line_gross_amount") @db.Decimal(18, 2)
  lineDiscountAmount      Decimal  @default(0) @map("line_discount_amount") @db.Decimal(18, 2)
  lineNetAmount           Decimal  @map("line_net_amount") @db.Decimal(18, 2)
  priceSource             String?  @map("price_source")
  discountAllowedSnapshot Boolean  @default(true) @map("discount_allowed_snapshot")
  sequence                Int      @default(0)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantService TenantService? @relation(fields: [tenantServiceId], references: [id], onDelete: SetNull)
  labOrderTest  LabOrderTest?  @relation(fields: [labOrderTestId], references: [id], onDelete: SetNull)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

/// Payment receipt against an invoice; idempotency key blocks duplicate submits (MOD-10)
model InvoicePayment {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  branchId       String               @map("branch_id")
  invoiceId      String               @map("invoice_id")
  receiptNumber  String               @map("receipt_number")
  amount         Decimal              @db.Decimal(18, 2)
  paymentMethod  InvoicePaymentMethod @default(CASH) @map("payment_method")
  status         InvoicePaymentStatus @default(RECEIVED)
  referenceNo    String?              @map("reference_no")
  note           String?
  idempotencyKey String?              @map("idempotency_key")
  receivedAt     DateTime             @default(now()) @map("received_at")
  receivedById   String?              @map("received_by_id")
  receivedByName String?              @map("received_by_name")
  reversedAt     DateTime?            @map("reversed_at")
  reversedById   String?              @map("reversed_by_id")
  reversalReason String?              @map("reversal_reason")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
  @@map("invoice_payments")
}

/// Immutable discount authorization trail for an invoice (MOD-10)
model InvoiceDiscountEvent {
  id                     String                   @id @default(cuid())
  tenantId               String                   @map("tenant_id")
  invoiceId              String                   @map("invoice_id")
  eventType              InvoiceDiscountEventType @map("event_type")
  previousDiscountType   InvoiceDiscountType      @default(NONE) @map("previous_discount_type")
  previousDiscountAmount Decimal                  @default(0) @map("previous_discount_amount") @db.Decimal(18, 2)
  newDiscountType        InvoiceDiscountType      @default(NONE) @map("new_discount_type")
  newDiscountValue       Decimal                  @default(0) @map("new_discount_value") @db.Decimal(18, 2)
  newDiscountAmount      Decimal                  @default(0) @map("new_discount_amount") @db.Decimal(18, 2)
  reason                 String?
  appliedAfterPayment    Boolean                  @default(false) @map("applied_after_payment")
  authorizedById         String?                  @map("authorized_by_id")
  authorizedByName       String?                  @map("authorized_by_name")
  authorizedAt           DateTime                 @default(now()) @map("authorized_at")
  createdAt              DateTime                 @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, authorizedAt])
  @@map("invoice_discount_events")
}
