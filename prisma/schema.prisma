  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("patient_portal_accounts")
}

/// Server-side portal session with hard expiry and revocation (MOD-30 PatientPortalSession)
model PatientPortalSession {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  accountId    String    @map("account_id")
  /// SHA-256 of the cookie value; the raw token is never stored.
  sessionToken String    @unique @map("session_token")
  expiresAt    DateTime  @map("expires_at")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  ipAddress    String?   @map("ip_address")
  deviceInfo   String?   @map("device_info")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PatientPortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, accountId])
  @@index([expiresAt])
  @@map("patient_portal_sessions")
}

/// Portal login attempt audit including failures (MOD-30 PatientPortalLoginHistory)
model PatientPortalLoginHistory {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  accountId  String?  @map("account_id")
  /// Login identifier as submitted, so failed attempts on unknown users stay auditable.
  username   String
  loginAt    DateTime @default(now()) @map("login_at")
  isSuccess  Boolean  @map("is_success")
  failReason String?  @map("fail_reason")
  ipAddress  String?  @map("ip_address")
